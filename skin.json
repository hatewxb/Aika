{
    "name": "Aika",
    "author": "hatewxb",
    "description": "Тёплая тёмная тема для Steam: Fluent-структура, панели в духе файловой системы и мягкие пятна света на почти чёрном фоне.",
    "version": "0.1.0a",
    "tags": ["Fluent", "Dark", "Warm", "Minimal", "WIP"],

    "RootColors": "root-colors.css",
    "Steam-WebKit": "webkit.css",

    "Conditions": {
        "Положение вкладок": {
            "description": "Где стоят вкладки «Магазин», «Библиотека», «Сообщество» и профиль в верхней панели.",
            "tab": "Верхняя панель",
            "default": "По центру",
            "values": {
                "По центру": {
                    "TargetCss": { "affects": ["^Steam$"], "src": "options/tabs-center.css" }
                },
                "Слева": {}
            }
        },
        "Пресет": {
            "description": "Набор цветов темы: акцент и пятна света. Чтобы задать цвета вручную, включите «Свои цвета» во вкладке «Расширенное».",
            "tab": "Цветовые пресеты",
            "default": "Aika",
            "values": {
                "Aika": {
                    "TargetCss": { "affects": [".*"], "src": "options/presets/aika.css" }
                }
            }
        },
        "Свои цвета": {
            "description": "Использовать цвета из редактора цветов темы вместо пресета. Сами цвета (акцент, наведение, три пятна света) настраиваются в разделе цветов этой темы.",
            "tab": "Расширенное",
            "default": "no",
            "values": {
                "no": {},
                "yes": {
                    "TargetCss": { "affects": [".*"], "src": "options/colors-manual.css" }
                }
            }
        },
        "Свечение за курсором": {
            "description": "Мягкое свечение акцента под курсором на крупных блоках библиотеки (панели страницы игры, «Что нового», коллекции).",
            "tab": "Расширенное",
            "default": "yes",
            "values": {
                "yes": {},
                "no": {
                    "TargetCss": { "affects": ["^Steam$"], "src": "options/spotlight-off.css" }
                }
            }
        },
        "Надпись в уведомлениях": {
            "description": "Шрифт надписи «Aika» на фоне всплывающих уведомлений.",
            "tab": "Уведомления",
            "default": "Готическая",
            "values": {
                "Готическая": {},
                "Японская": {
                    "TargetCss": { "affects": [".*"], "src": "options/toast-mark-brush.css" }
                }
            }
        },
        "Плотность уведомлений": {
            "description": "Насколько уведомление закрывает рабочий стол: меньше — прозрачнее.",
            "tab": "Уведомления",
            "default": 62,
            "slider": {
                "cssVariable": "--aika-setting-toast-tint",
                "min": 20,
                "max": 95,
                "step": 5,
                "unit": "%"
            }
        },
        "Радиус свечения": {
            "description": "Размер свечения за курсором, в пикселях.",
            "tab": "Расширенное",
            "default": 160,
            "slider": {
                "cssVariable": "--aika-setting-spot-size",
                "min": 60,
                "max": 400,
                "step": 20,
                "unit": "px"
            }
        }
    },

    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css",
            "TargetJs": "js/spotlight.js"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".ContextMenuPopup",
            "TargetCss": "popup.css"
        },
        {
            "MatchRegexString": ".DesktopToastContainer",
            "TargetCss": "toast.css",
            "TargetJs": "js/toast-glass.js"
        },
        {
            "MatchRegexString": "^https://store\\.steampowered\\.com/app/.*",
            "TargetJs": "js/store-logo.js"
        },
        {
            "MatchRegexString": "^https://steamcommunity\\.com/(id|profiles)/[^/]+/screenshots.*",
            "TargetJs": "js/content-shelves.js"
        }
    ]
}
