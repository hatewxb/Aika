{
    "name": "Aika",
    "author": "belok",
    "description": "Тёплая тема для Steam: Fluent-структура, материал Liquid Glass и мягкий свет. Стеклянные панели над живым фоном из плывущих пятен света.",
    "version": "0.1.0",
    "tags": ["Glass", "Fluent", "Dark", "Warm", "WIP"],

    "RootColors": "colors.css",
    "Steam-WebKit": "webkit.css",

    "Patches": [
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".ModalDialogPopup",
            "TargetCss": "main.css"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "main.css"
        }
    ]
}
